# ==========================================
# 1. University Documents & Study Materials
# ==========================================
# Exclude slides, manuals, and notes
*.pdf
*.ppt
*.pptx
*.doc
*.docx
*.xls
*.xlsx
*.txt

# Exclude images
*.png
*.jpg
*.jpeg
*.gif

# Exclude compressed archives
*.zip
*.rar
*.7z

# EXCEPTIONS: Keep README files
!README.md
!readme.md
!README.txt

# ==========================================
# 2. STM32CubeIDE & Build Files
# ==========================================
# Exclude compilation output folders generated by the IDE
Debug/
Release/
build/

# Exclude compiled binaries and object files
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.list
*.su
*.log

# Exclude STM32CubeMX backup and temporary files
*.bak
*.tmp
.mxproject

# ==========================================
# 3. OS & Editor Generated Files
# ==========================================
.DS_Store
Thumbs.db
.vscode/